# Copy this file to .env and fill in real values. Never commit .env.
# These names are provisional until the backend settings are scaffolded.
# Keep this file in sync with the settings the code actually reads.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 18
POSTGRES_DB=dinnerbell
POSTGRES_USER=dinnerbell
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis 8 (Celery broker)
CELERY_BROKER_URL=redis://localhost:6379/0
